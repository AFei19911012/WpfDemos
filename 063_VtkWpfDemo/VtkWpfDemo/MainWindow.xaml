<Window x:Class="VtkWpfDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VtkWpfDemo"
        xmlns:vtk="clr-namespace:Kitware.VTK"
        xmlns:wff="clr-namespace:WffControls.Controls;assembly=WffControls"
        mc:Ignorable="d"
        Title="MainWindow"
        Height="650"
        Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <WindowsFormsHost Margin="5">
            <vtk:RenderWindowControl x:Name="vtk_render" />
        </WindowsFormsHost>

        <WrapPanel Grid.Row="1">
            <wff:Button Content="vtkShrinkPolyData 下采样"
                        Click="VtkShrinkPolyData_Click"
                        Margin="5" />
            <wff:Button Content="vtkElevationFilter 颜色映射"
                        Click="VtkElevationFilter_Click"
                        Margin="5" />
            <wff:Button Content="vtkDecimatePro 下采样"
                        Click="VtkDecimatePro_Click"
                        Margin="5" />
            <wff:Button Content="vtkCleanPolyData 下采样"
                        Click="VtkCleanPolyData_Click"
                        Margin="5" />
            <wff:Button Content="vtkVoxelGrid 下采样"
                        Click="VtkVoxelGrid_Click"
                        Margin="5" />
            <wff:Button Content="vtkSurfaceReconstructionFilter 曲面重建"
                        Click="VtkSurfaceReconstructionFilter_Click"
                        Margin="5" />
            <wff:Button Content="vtkDelaunay2D 表面重建"
                        Click="VtkDelaunay2D_Click"
                        Margin="5" />
            <wff:Button Content="vtkSmoothPolyDataFilter 平滑表面"
                        Click="VtkSmoothPolyDataFilter_Click"
                        Margin="5" />
            <wff:Button Content="读取文件"
                        Click="LoadFile_Click"
                        Margin="5" />
            <wff:Button Content="图片纹理"
                        Click="TextureMap_Click"
                        Margin="5" />
        </WrapPanel>
    </Grid>
</Window>