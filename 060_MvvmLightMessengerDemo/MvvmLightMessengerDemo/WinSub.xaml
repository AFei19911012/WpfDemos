<Window x:Class="MvvmLightMessengerDemo.WinSub"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MvvmLightMessengerDemo"
        mc:Ignorable="d" Title="WinSub"
        Height="250" Width="400">
    <UniformGrid Columns="2">
        <TextBox Name="tb" HorizontalAlignment="Center"
                 VerticalAlignment="Center" Width="100" />
        <Button Content="发送消息" HorizontalAlignment="Center"
                VerticalAlignment="Center" Click="Button_Click" />
    </UniformGrid>
</Window>