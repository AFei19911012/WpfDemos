<Window x:Class="SkiaSharpDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SkiaSharpDemo"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF"
        mc:Ignorable="d"
        Title="SkiaSharp Sample"
        Height="450"
        Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <UniformGrid Columns="2">
            <Image x:Name="img"
                   Margin="10" />
            <skia:SKElement PaintSurface="OnPaintSurface"
                            IgnorePixelScaling="True" />
        </UniformGrid>


        <WrapPanel Grid.Row="1"
                   Margin="10">
            <Button Margin="10"
                    Padding="5"
                    FontSize="20"
                    Content="使用Skia绘制"
                    Click="OnDraw_Click" />
            <Button Margin="10"
                    Padding="5"
                    FontSize="20"
                    Content="使用Skia拼图"
                    Click="OnMontage_Click" />
        </WrapPanel>

    </Grid>
</Window>